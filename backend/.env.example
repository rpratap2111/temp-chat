# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/temp-chat

# Allowed browser origin(s) for CORS, comma-separated
VITE_URL=http://localhost:5173

# Port to listen on (hosting providers usually set this for you)
PORT=4000

# Set to 1 when running behind a reverse proxy such as Render, so rate limits
# use the real client IP from X-Forwarded-For. Leave unset otherwise.
TRUST_PROXY=
